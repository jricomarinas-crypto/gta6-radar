# Copia este archivo como .env SOLO si lo ejecutas en tu ordenador.
# En GitHub, estos valores van en Settings → Secrets and variables → Actions.

# Obligatorias
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# Para subir vídeos a tu canal (tools/get_youtube_token.py)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Opcionales
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
